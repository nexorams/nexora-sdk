{
  "compilerOptions": {
    "target": "ES2022",
    "types": [
      "node"
    ],
    "module": "ES2022",
    "moduleResolution": "node",
    "declaration": false,
    "outDir": "./dist/esm",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
  },
  "include": [
    "src/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "test"
  ]
}